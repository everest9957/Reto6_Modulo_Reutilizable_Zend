<h1>Editar Comentario #<?= $comentario->id ?></h1>
<form method="post">
    <div class="form-group">
        <label>Autor</label>
        <input type="text" name="autor" value="<?= $this->escapeHtml($comentario->autor) ?>" class="form-control">
    </div>
    <div class="form-group">
        <label>Email</label>
        <input type="email" name="email" value="<?= $this->escapeHtml($comentario->email) ?>" class="form-control">
    </div>
    <div class="form-group">
        <label>Contenido</label>
        <textarea name="contenido" class="form-control" rows="4"><?= $this->escapeHtml($comentario->contenido) ?></textarea>
    </div>
    <div class="form-group">
        <label>Estado</label>
        <select name="estado" class="form-control">
            <option value="pendiente" <?= $comentario->estado == 'pendiente' ? 'selected' : '' ?>>Pendiente</option>
            <option value="aprobado"  <?= $comentario->estado == 'aprobado'  ? 'selected' : '' ?>>Aprobado</option>
            <option value="rechazado" <?= $comentario->estado == 'rechazado' ? 'selected' : '' ?>>Rechazado</option>
        </select>
    </div>
    <button type="submit" class="btn btn-primary">Guardar</button>
    <a href="<?= $this->url('comentarios-admin') ?>" class="btn btn-secondary">Cancelar</a>
</form>
